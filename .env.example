# CareerPilot AI - environment variable reference. Names only: never put real values here.
#
# Local development uses two real (gitignored) files:
#   .env                 copy of this file; read by docker compose AND the Python backend/worker
#   frontend/.env.local  only the NEXT_PUBLIC_* values (Next.js reads its own folder)
# Production: set the same names in the Render/Railway and Vercel dashboards instead.
# Comments sit on their own lines because some .env parsers do not support inline comments.
# "Phase N" says when a variable first becomes used; unused ones may stay empty until then.

# --- App ---
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = one JSON object per log line (production); false = readable console output
LOG_JSON=false

# --- Local infrastructure (docker/docker-compose.yml) ---
# Only for the optional local Docker containers. Leave these empty when you use Supabase: your
# Supabase database password goes inside DATABASE_URL, in .env, never in this file.
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
REDIS_PORT=63799

# --- Backend: data stores (Phase 1) ---
# Supabase: Dashboard > Connect > Session pooler (port 5432, works over IPv4). Either
# postgresql:// or postgresql+psycopg:// is accepted. URL-encode special characters in the password.
# See docs/SUPABASE_SETUP.md.
# Local Docker alternative: postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:54329/careerpilot
DATABASE_URL=
# Database used by the DB tests. Use the DEV project, never production. The tests clean up after
# themselves but they do write to this database.
TEST_DATABASE_URL=
REDIS_URL=redis://localhost:63799/0

# --- Backend: security (Phase 1) ---
# Fernet key that encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Project URL, e.g. https://<project-ref>.supabase.co . Used to derive the token issuer and the
# JWKS URL that access tokens are verified against.
SUPABASE_URL=
# Optional override of <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Only for projects still on the legacy HS256 shared secret. Leave empty when the project uses
# asymmetric signing keys: verification then uses the public JWKS and needs no secret.
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Backend: optional tuning (defaults shown) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=10

# --- Providers (added in the phase that implements each one) ---
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
HUNTER_API_KEY=
EMAIL_VERIFICATION_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Frontend (goes in frontend/.env.local; Phase 2) ---
# The publishable key (sb_publishable_...) is public by design; it is only safe because RLS is
# enabled on every table. Never put the secret key (sb_secret_...) or the legacy service_role key
# in frontend variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
